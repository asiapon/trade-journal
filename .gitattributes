# Windows 批处理必须 CRLF，否则 cmd 解析 if 块会出错
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Shell 脚本必须 LF，否则 Linux/macOS 上会报 bad interpreter
*.sh    text eol=lf

# PowerShell 保持 CRLF（Windows 原生）
*.ps1   text eol=crlf

# 源码与文档统一 LF，减少无意义 diff
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制文件不要做换行转换
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.gz    binary
*.tgz   binary
