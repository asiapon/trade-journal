  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",

    "ops": "node ops/cli.mjs",
    "check": "node ops/cli.mjs dev check",

    "publish": "node ops/cli.mjs help",
    "publish:check": "node ops/cli.mjs dev check",
    "publish:cf": "node ops/cli.mjs cf deploy",
