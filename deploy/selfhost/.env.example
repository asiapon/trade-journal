# 操作日记自托管后端配置（复制为 .env 后修改）

# 服务端口
PORT=3000

# K 线定时采集：每天该时刻（服务器本地时间，建议收盘后如 17:30）自动增量入库。
# 留空/缺省 = 17:30。另：后端启动时会自动补齐一次（库空则全市场回补，3-5 分钟）。
SYNC_AT=17:30

# PostgreSQL 连接串（install 脚本会自动生成；手动安装时改成你的密码）
DATABASE_URL=postgresql://stockjournal:CHANGE_ME@localhost:5432/stockjournal

# 访问密钥校验（可选）：1 = 必须带 x-wb-webapp-access-key 头且等于 ACCESS_KEY；
# 0/缺省 = 不校验（前端固定带一个 key 头，仅作为与云端协议兼容的占位）。
# 公网部署建议 REQUIRE_KEY=1 并自定义 ACCESS_KEY，再加反向代理 HTTPS。
REQUIRE_KEY=0
ACCESS_KEY=

# ---------------------------------------------------------------------------
# 云端模型代理（可选，v3.21.0）
# ---------------------------------------------------------------------------
# 作用：本地部署时也能用 WorkBuddy 的免密模型（消耗账号积分）。
# 原理：浏览器直连 /.cloud/llm/* 会因「Origin 必须等于应用域名」被拒；
#      由本后端代持 key 发请求（服务端不受 Origin 限制），故能通。
#
# 必填两个值，都来自那个 WorkBuddy 应用：
#   LLM_ENDPOINT = 应用的发布域名，如 https://xxx.app.workbuddy.host
#   LLM_KEY      = 该应用的 publishableKey，wbpk_ 开头
#
# ⚠ 重要：这两个值**绑死那个应用**。应用被删除或下线，这里立刻失效 ——
#   前端会自动降级到「自定义模型」，不会报错卡住。
#   如果长期不想依赖平台，请改用自定义模型（设置 → AI 模型 → 自定义，
#   填 DeepSeek / 通义等 OpenAI 兼容地址即可）。
#
# 留空 = 不启用代理，前端直接走自定义模型。
LLM_ENDPOINT=
LLM_KEY=
