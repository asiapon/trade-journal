node_modules/
dist/
.wrangler/
deploy/cloudflare/.wrangler/
*.log
# .env 必须递归匹配：仅写 `.env` 只忽略根目录，deploy/selfhost/.env 会漏网（含真实密钥）
.env
.env.*
!.env.example
.env.local
!.env.*.example
# 发布暂存快照（在仓库外，由 ops wb sync 生成，可随时重建）
.workbuddy/backup/
# WorkBuddy 本地状态与云服务激活标记（含 appId，不入版本库）
.workbuddy/
.wbapp_*.genie
# 自托管备份产物（数据库 dump 里有全部记账数据，绝不入版本库）
backups/
# 自托管运行时残留
.pid
deploy/selfhost/.pid

